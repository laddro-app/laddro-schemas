{
  "name": "@laddro-app/schemas",
  "version": "0.12.0",
  "description": "Shared OpenAPI 3.1 schemas for Laddro APIs (resume, cover letter, tailor, skills, content, bullets, inbox).",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./resume": {
      "types": "./dist/resume.gen.d.ts",
      "default": "./dist/resume.gen.js"
    },
    "./cover-letter": {
      "types": "./dist/cover-letter.gen.d.ts",
      "default": "./dist/cover-letter.gen.js"
    },
    "./tailor": {
      "types": "./dist/tailor.gen.d.ts",
      "default": "./dist/tailor.gen.js"
    },
    "./skills": {
      "types": "./dist/skills.gen.d.ts",
      "default": "./dist/skills.gen.js"
    },
    "./content": {
      "types": "./dist/content.gen.d.ts",
      "default": "./dist/content.gen.js"
    },
    "./bullets": {
      "types": "./dist/bullets.gen.d.ts",
      "default": "./dist/bullets.gen.js"
    },
    "./inbox": {
      "types": "./dist/inbox.gen.d.ts",
      "default": "./dist/inbox.gen.js"
    },
    "./json/resume": {
      "types": "./dist/json/resume.d.ts",
      "default": "./dist/json/resume.js"
    },
    "./json/cover-letter": {
      "types": "./dist/json/cover-letter.d.ts",
      "default": "./dist/json/cover-letter.js"
    },
    "./json/resume.schema.json": "./dist/json/resume.schema.json",
    "./json/cover-letter.schema.json": "./dist/json/cover-letter.schema.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "scripts": {
    "generate": "bash ../scripts/generate-ts.sh && npm run generate:json",
    "generate:json": "node ../scripts/generate-json-schema.mjs",
    "build": "tsc -p tsconfig.json && npm run generate:json",
    "prepublishOnly": "npm run generate && npm run build"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "openapi-typescript": "^7.0.0",
    "typescript": "^5.5.0",
    "yaml": "^2.5.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laddro-app/laddro-schemas.git",
    "directory": "ts"
  }
}
